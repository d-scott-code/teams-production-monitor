    {
      "id": "19:0767c447cdb841f296fa0b0e3ff8c82e@thread.v2",
      "topic": "L1 Schedule",
      "plant": "L1",
      "web_url": "https://teams.microsoft.com/l/chat/19%3A0767c447cdb841f296fa0b0e3ff8c82e%40thread.v2/0?tenantId=46913ced-e190-4f33-b3f3-2a38ddf9cac4",
      "messages": [
        {
          "id": "1786831828335",
          "from": "Dakota Adair",
          "from_upn": null,
          "sent_utc": "2026-08-15T22:10:28.335Z",
          "sent_mt": "2026-08-15T16:10:28-06:00",
          "text": "This is the plan for S2 due to the belt ripping. \n\n1. Draining decorator melting tank on S3 and placing the chocolate into S3’s buffer tank.\n\n2. Push chocolate from S2 melting tank into the dark buffer tank until it’s at 80% \n\n3. Remaining chocolate from S2 will be transferred into S3’s decorator melting tank. \n\nThis will ensure we have a melting tank empty Monday morning and have a better chance on start up Monday morning.  Curt Willis, Chad Stone, Daniel Bringas\n\nKirk Nickel, Ethan Bean We will need more black barrels Wednesday to drain the decorator melting tank to prep for the pecan run on S3 Thursday. \n\nFYI Jody Howse, Justin Garner",
          "importance": "normal",
          "web_url": null
        }
      ]
    },
